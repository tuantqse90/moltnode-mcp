{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.tuantqse90/moltnode",
  "title": "MoltNode by Chord",
  "description": "Read 31 blockchains over JSON-RPC and swap via Chord: best route, unsigned tx, simulation. No key.",
  "version": "1.1.4",
  "websiteUrl": "https://moltnode.ag/agents",
  "repository": {
    "url": "https://github.com/tuantqse90/moltnode-mcp",
    "source": "github"
  },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://moltnode.ag/mcp"
    }
  ],
  "icons": [
    {
      "src": "https://raw.githubusercontent.com/tuantqse90/moltnode-mcp/main/assets/logo.png",
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ]
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "moltnode-mcp",
      "version": "1.1.4",
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
