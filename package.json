{
  "name": "moltnode-mcp",
  "version": "0.1.0",
  "description": "Zero-config, no-key MCP server for 31+ chains via the MoltNode RPC gateway (moltnode.ag). For humans and agents.",
  "type": "module",
  "bin": {
    "moltnode-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "prepack": "npm run build",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "rpc",
    "json-rpc",
    "ethereum",
    "evm",
    "solana",
    "sui",
    "web3",
    "blockchain",
    "moltnode",
    "agents",
    "claude"
  ],
  "license": "MIT",
  "author": "nullshift labs (0xtunad)",
  "homepage": "https://moltnode.ag",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuantqse90/moltnode-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/tuantqse90/moltnode-mcp/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
